# Allowlist: ignore everything, then explicitly allow what should be tracked.
*
!*/

# Code
!*.go
!go.mod
!go.sum

# Documentation
!*.md
!LICENSE

# Herdr reference captures kept by reference/herdr/RESYNC.md
!reference/herdr/raw/schema.json
!reference/herdr/raw/llms.txt
!reference/herdr/raw/default-config.toml

# Repo config
!.gitignore
!.github/workflows/ci.yml
!.github/workflows/release.yml
!.github/scripts/check-tag.sh
!.github/scripts/package.sh


# Test fixtures
!**/testdata/**

# Personal files of the user at the repository root. Never tracked.
/memory/
/overrides/
/plans/
/handoff.md
/_archive/

# Development scratch files and the runtime data of the old home.
/.hive/
