# Allowlist: ignore everything, then explicitly allow what should be tracked.
*
!*/

# Code
!*.go
!go.mod
!go.sum

# Documentation
!*.md
!LICENSE

# Herdr reference captures kept by reference/herdr/RESYNC.md
!reference/herdr/raw/schema.json
!reference/herdr/raw/llms.txt
!reference/herdr/raw/default-config.toml

# Agent profiles
!profiles/*.md

# Repo config
!.gitignore
!.github/workflows/ci.yml
!.github/workflows/release.yml
!.github/scripts/check-tag.sh
!.github/scripts/package.sh

# Skill discovery links for Claude Code
!.claude/skills/hive-coordinator
!.claude/skills/hive-manager
!.claude/skills/hive-worker
!.claude/skills/hive-verifier
!.claude/skills/hive-agent

# Test fixtures
!**/testdata/**

# Personal and runtime data of the home (the checkout is the home). Never tracked.
/projects/
/memory/
/overrides/
/plans/
/handoff.md
.hive/*
!.hive/README.md
